# docker-compose.prod.yml 실행 시 사용하는 환경변수 예시 파일입니다.
# 실제 값을 채운 .env.prod 파일은 서버에서 직접 만들어 사용하세요 (git에는 절대 커밋하지 마세요).
#
# 사용법(서버에서):
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Oracle Autonomous Database TLS 접속 문자열 (Wallet 없이 TLS로 접속)
# OCI 콘솔 > Autonomous Database > DB Connection에서 tp(trackerdb_tp) 서비스의 접속 문자열을 그대로 사용
DB_URL=jdbc:oracle:thin:@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=<호스트>))(connect_data=(service_name=<서비스명>))(security=(ssl_server_dn_match=yes)))

DB_USERNAME=TRACKER
DB_PASSWORD=<비밀번호>

# 최초 1회만 데모(Task) 데이터까지 함께 채우고 싶다면 prod,seed 유지,
# 이후에는 prod로 바꾸는 것을 권장 (재기동마다 데모 데이터가 초기화되는 걸 원치 않는 경우)
SPRING_PROFILES=prod,seed